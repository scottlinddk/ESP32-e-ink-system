PORT=3001
NODE_ENV=development
# Migration write freeze: true returns 503 on all application routes except health.
# Redeploy after changing; also stop old deployments/external writers and drain requests.
DATABASE_MAINTENANCE_MODE=false
FRONTEND_URL=http://localhost:5173

# GitHub repo for automatic firmware resolution (owner/repo).
# When set, the backend fetches the latest release (including pre-releases) from the
# GitHub API and selects a complete release containing all three factory images.
# Application-only releases are not offered by the USB installer.
GITHUB_REPO=scottlinddk/ESP32-e-ink-system
# Optional GitHub PAT for higher API rate limits (5000/hr vs 60/hr unauthenticated).
GITHUB_TOKEN=

# Optional local validation: absolute directory generated by package_web_firmware.py.
# Includes factory binaries, manifests, and SHA256SUMS. Leave blank for GitHub releases.
FIRMWARE_RELEASE_DIR=
# Optional absolute public backend base, including /api when behind that prefix.
# Normally leave blank: the installer uses same-origin relative download paths.
BACKEND_PUBLIC_BASE_URL=

# ---- PostgreSQL (direct connection, runtime only) -------------------------------------------
# The API connects straight to PostgreSQL with the `pg` driver. This value contains a password:
# set it only in the server environment (Coolify "Environment Variables", runtime), never in the
# frontend, never in a build argument, never in git.
#
# Use the dedicated, least-privilege application role (eink_app), not the admin/migration role.
# Create it with backend/src/db/roles/app-role.sql; see docs/DATABASE.md.
# Percent-encode special characters in the password (e.g. @ -> %40).
# Do not put sslmode=... in the URL: configure TLS with DATABASE_SSL below.
DATABASE_URL=postgresql://eink_app:change-me@localhost:5432/eink
# TLS to PostgreSQL. verify-full (default) checks the certificate chain AND the host name.
# disable = plain TCP, acceptable only on a private network between two containers (e.g. one Coolify
# network). There is deliberately no "require" or "no-verify" mode.
DATABASE_SSL=disable
# Private CA that signed the server certificate (PEM, \n allowed), or a file path. Optional.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=/run/secrets/postgres-ca.pem
# Pool: keep it small on a small VPS. Postgres max_connections is shared with everything else;
# a rolling deploy briefly runs two API containers, so allow 2 x DATABASE_POOL_MAX connections.
# DATABASE_POOL_MAX=5
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Keep ENCRYPTION_KEY below identical to the old deployment: stored provider keys are encrypted with it.

# Clerk
CLERK_SECRET_KEY=sk_test_your_key
CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Third-party API keys (fallback if user hasn't added their own)
OPENWEATHERMAP_API_KEY=your_key
NEWS_API_KEY=your_key

# JWT (for future custom auth if needed)
JWT_SECRET=your_random_secret_at_least_32_chars

# AES-256-GCM key for encrypting user API keys at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# Optional: how often an instant-updates device checks for a screen request
# (integer seconds, clamped to 2-60, default 5). Each check is one function
# invocation and, with Upstash configured, one rate-limit call per device.
# DEVICE_INSTANT_CHECK_SECONDS=5
