PORT=3001
NODE_ENV=development
# Migration write freeze: true returns 503 on all application routes except health.
# Redeploy after changing; also stop old deployments/external writers and drain requests.
DATABASE_MAINTENANCE_MODE=false
FRONTEND_URL=http://localhost:5173

# GitHub repo for automatic firmware resolution (owner/repo).
# When set, the backend fetches the latest release (including pre-releases) from the
# GitHub API and uses its firmware.bin asset as the default firmware — no manual
# URL updates needed after each release.
GITHUB_REPO=scottlinddk/ESP32-e-ink-system
# Optional GitHub PAT for higher API rate limits (5000/hr vs 60/hr unauthenticated).
GITHUB_TOKEN=

# Fallback firmware — used only when GITHUB_REPO is not set or GitHub is unreachable.
# When set, the backend proxies this URL for esp-web-tools flashing (avoids CORS issues).
# Use a GitHub Releases asset URL, e.g.:
#   https://github.com/scottlinddk/ESP32-e-ink-system/releases/download/v1.0.0/firmware.bin
# Leave blank if you place firmware/builds/default.bin locally instead.
DEFAULT_FIRMWARE_URL=
DEFAULT_FIRMWARE_VERSION=1.0.0

# Database REST API: hosted Supabase OR the Pi's PostgreSQL/PostgREST gateway.
# Pi setup: docs/RASPBERRY_PI_DATABASE_MIGRATION.md. Use its HTTPS origin
# without /rest/v1; the SDK adds that path. The Pi needs its generated service JWT.
# Keep ENCRYPTION_KEY below identical when migrating existing encrypted rows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clerk
CLERK_SECRET_KEY=sk_test_your_key
CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Third-party API keys (fallback if user hasn't added their own)
OPENWEATHERMAP_API_KEY=your_key
NEWS_API_KEY=your_key

# JWT (for future custom auth if needed)
JWT_SECRET=your_random_secret_at_least_32_chars

# AES-256-GCM key for encrypting user API keys at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here
