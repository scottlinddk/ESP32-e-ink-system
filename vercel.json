{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.ts",
      "functions": {
        "api/index.ts": {
          "includeFiles": "{src/services/calendarWorker.cjs,../node_modules/node-ical/windowsZones.json}"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "build": {
    "env": {
      "VITE_FRONTEND_URL": "/",
      "VITE_BACKEND_URL": "/api"
    }
  }
}
