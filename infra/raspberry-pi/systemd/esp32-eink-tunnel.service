[Unit]
Description=ESP32 e-ink database HTTPS tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=esp32-eink-tunnel
Group=esp32-eink-tunnel
# Check `command -v cloudflared` and adjust this path before installation.
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --config /etc/esp32-eink/cloudflared.yml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
