# Generate actual .env and backend.env with generate-secrets.py on the Pi.
# These are version pins checked against publisher listings on 2026-09-28.
# Before deployment, inspect linux/arm64 manifests and record @sha256 digests.
POSTGRES_IMAGE=postgres:17.11-bookworm
POSTGREST_IMAGE=postgrest/postgrest:v14.18
NGINX_IMAGE=nginx:1.30.5-alpine

# Use / only when the system root filesystem is the verified SSD. For another
# existing mount, set its real path and verify its Docker/systemd mount guard.
# Never use Investor's /srv/investor tree, even for a separate subdirectory.
STORAGE_MOUNT=/
STORAGE_UUID=
DATA_DIR=/srv/esp32-eink/postgres
MIGRATION_WORK_DIR=/srv/esp32-eink/migration
PG_CONFIG_DIR=/etc/esp32-eink/pgconfig

# Empty placeholders deliberately fail Compose validation.
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
JWT_SECRET=
